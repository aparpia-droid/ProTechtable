generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String
  firstName                String?
  lastName                 String?
  encryptedPhone           String?
  encryptedDob             String?
  subscriptionTier         String    @default("free")
  stripeCustomerId         String?
  emailVerified            Boolean   @default(false)
  verificationToken        String?
  verificationTokenExpiry  DateTime?
  resetToken               String?
  resetTokenExpiry         DateTime?
  passwordChangedAt        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  assessments              Assessment[]
  remediationActions       RemediationAction[]
  extraEmails              UserEmail[]

  brokerRemovals       BrokerRemoval[]
  monitoringAlerts     MonitoringAlert[]
  monitoringEnabled    Boolean         @default(false)
  isStudent            Boolean         @default(false)

  @@index([stripeCustomerId])
  @@index([verificationToken])
  @@index([resetToken])
}

model Assessment {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailSearched         String
  score                 Int
  riskLevel             String
  breachesFound         Int
  dataBrokersFound      Int
  publicProfiles        Int       @default(0)
  assessmentData        Json
  status                String    @default("completed")
  quickWinsEmailSentAt  DateTime?
  progressNudgeSentAt   DateTime?
  rescanReminderSentAt  DateTime?
  createdAt             DateTime  @default(now())
  remediationActions    RemediationAction[]

  @@index([userId])
}

model UserEmail {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email               String
  verified            Boolean   @default(false)
  verifyCodeHash      String?
  verifyCodeExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  @@unique([userId, email])
  @@index([userId])
}

model RemediationAction {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  actionType   String
  actionTarget String
  status       String    @default("pending")
  isAutomated  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([userId])
  @@index([assessmentId])
}

model DataBroker {
  id            String @id @default(uuid())
  name          String @unique
  removalUrl    String
  removalMethod String
  difficulty    String

  category        String        @default("people_search")
  dataTypes       String        @default("name,address,phone")
  optOutEmail     String?
  optOutTemplate  String?
  estimatedDays   Int           @default(14)
  removals        BrokerRemoval[]
}

model BrokerRemoval {
  id            String    @id @default(uuid())
  userId        String
  brokerId      String
  status        String    @default("not_started")
  requestedAt   DateTime?
  submittedAt   DateTime?
  confirmedAt   DateTime?
  nextFollowUp  DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker        DataBroker @relation(fields: [brokerId], references: [id])

  @@unique([userId, brokerId])
  @@index([userId])
  @@index([status])
}

model WebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  eventType     String
  createdAt     DateTime @default(now())
}

model MonitoringAlert {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  description String
  metadata    Json?
  read         Boolean  @default(false)
  createdAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
